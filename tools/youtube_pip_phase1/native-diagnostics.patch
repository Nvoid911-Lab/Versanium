+// VSPIP_DIAGNOSTIC_BEGIN
+#if BUILDFLAG(IS_ANDROID)
+void HTMLMediaElement::VersaniumLogMediaDiagnostic(
+    const char* event,
+    int reason,
+    int fullscreen_status,
+    int disable_picture_in_picture) const {
+  const auto* frame = GetDocument().GetFrame();
+  // DocumentLoader installs navigation documents with an existing token.
+  // Avoid Token()'s lazy allocation on detached/non-navigation documents.
+  const bool has_navigation_document =
+      frame && frame->GetDocument() == &GetDocument() && GetDocument().Loader();
+  LOG(INFO) << "VSPIP event=" << event
+            << " tick_us=" << base::TimeTicks::Now().since_origin().InMicroseconds()
+            << " source=" << (reason >= 0 ? "HTMLMediaElement::PauseInternal" :
+                fullscreen_status >= 0 ? "HTMLVideoElement::SetIsEffectivelyFullscreen" :
+                "HTMLMediaElement::CreateMediaPlayer") << " player="
+            << (web_media_player_ ? web_media_player_->GetPlayerId() : -1)
+            << " document=" << (has_navigation_document ? GetDocument().Token().ToString() : "unknown")
+            << " frame=" << (frame ? frame->GetLocalFrameToken().ToString() : "unknown")
+            << " is_main_frame=" << (frame ? (frame->IsMainFrame() ? "true" : "false") : "unknown")
+            << " page_hidden=" << GetDocument().hidden()
+            << " paused_before=" << paused_ << " reason=" << reason
+            << " fullscreen=" << (fullscreen_status < 0 ? "unknown" :
+                fullscreen_status == static_cast<int>(WebFullscreenVideoStatus::kNotEffectivelyFullscreen) ? "false" : "true")
+            << " disable_picture_in_picture=" << (disable_picture_in_picture < 0 ? "unknown" :
+                disable_picture_in_picture ? "true" : "false")
+            << " status=" << (fullscreen_status == static_cast<int>(WebFullscreenVideoStatus::kFullscreenAndPictureInPictureEnabled) ? "enabled" :
+                fullscreen_status == static_cast<int>(WebFullscreenVideoStatus::kFullscreenAndPictureInPictureDisabled) ? "disabled" :
+                fullscreen_status == static_cast<int>(WebFullscreenVideoStatus::kNotEffectivelyFullscreen) ? "not_fullscreen" : "unknown");
+}
+#endif
+// VSPIP_DIAGNOSTIC_END
 void HTMLMediaElement::PauseInternal(WebMediaPlayer::PauseReason pause_reason) {
+// VSPIP_DIAGNOSTIC_BEGIN
+#if BUILDFLAG(IS_ANDROID)
+  // Capture the first request while running; repeated already-paused calls are noise.
+  if (!paused_) {
+    VersaniumLogMediaDiagnostic("MEDIA_PAUSE_REQUEST",
+                                static_cast<int>(pause_reason));
+  }
+#endif
+// VSPIP_DIAGNOSTIC_END
   DVLOG(3) << "pauseInternal(" << *this << ")";

