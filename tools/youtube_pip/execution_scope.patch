+#if BUILDFLAG(IS_ANDROID)
+void RenderFrameHostImpl::ExecuteVersaniumYoutubeCandidate(
+    bool mobile, JavaScriptResultCallback callback) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!IsVersaniumYoutubeScopeAllowed(this))
+    return;
+  AssertFrameWasCommitted();
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  std::u16string options = u"{\"mobile\":";
+  options += mobile ? u"true" : u"false";
+  options += u",\"pip\":";
+  options += command->HasSwitch("versanium-youtube-pip-candidate") ? u"true" : u"false";
+  options += u",\"background\":";
+  options += command->HasSwitch("versanium-youtube-background-candidate") ? u"true" : u"false";
+  options += u",\"diagnostics\":";
+  options += command->HasSwitch("versanium-youtube-diagnostics") ? u"true" : u"false";
+  options += u"}";
+  std::u16string script = kVersaniumYoutubeCandidate;
+  base::ReplaceSubstringsAfterOffset(&script, 0, u"__VERSANIUM_OPTIONS__", options);
+  const bool wants_result = !callback.is_null();
+  GetAssociatedLocalFrame()->JavaScriptExecuteRequest(script, wants_result,
+                                                     std::move(callback));
+}
