+#if BUILDFLAG(IS_ANDROID)
+bool RenderFrameHostImpl::IsVersaniumYoutubeScopeAllowed(RenderFrameHost* frame) {
+  if (!frame || !frame->IsRenderFrameLive() || !frame->IsActive() ||
+      frame->GetParentOrOuterDocumentOrEmbedder() ||
+      !base::CommandLine::InitializedForCurrentProcess()) {
+    return false;
+  }
+  BrowserContext* candidate_context = frame->GetProcess()->GetBrowserContext();
+  if (candidate_context->IsOffTheRecord() || candidate_context->ShutdownStarted()) {
+    return false;
+  }
+  const GURL& candidate_url = frame->GetLastCommittedURL();
+  if (!candidate_url.SchemeIs("https") ||
+      !(candidate_url.host_piece() == "youtube.com" ||
+        candidate_url.host_piece() == "www.youtube.com" ||
+        candidate_url.host_piece() == "m.youtube.com")) {
+    return false;
+  }
+  const auto* candidate_command = base::CommandLine::ForCurrentProcess();
+  return candidate_command->HasSwitch("versanium-youtube-pip-candidate") ||
+         candidate_command->HasSwitch("versanium-youtube-background-candidate") ||
+         candidate_command->HasSwitch("versanium-youtube-diagnostics");
+}
