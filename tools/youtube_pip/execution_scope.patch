+void WebContentsAndroid::ApplyVersaniumYoutubeCandidate(
+    JNIEnv* env, bool mobile, const JavaRef<jobject>& callback) {
+  auto* frame = web_contents_->GetPrimaryMainFrame();
+  if (!web_contents_->GetRenderViewHost() ||
+      !RenderFrameHostImpl::IsVersaniumYoutubeScopeAllowed(frame)) {
+    return;  // No frame initialization, user gesture, or generic JS permission.
+  }
+  ScopedJavaGlobalRef<jobject> j_callback;
+  RenderFrameHost::JavaScriptResultCallback result_callback;
+  if (callback) {
+    j_callback.Reset(env, callback);
+    result_callback = base::BindOnce(&JavaScriptResultCallback, j_callback);
+  }
+  static_cast<RenderFrameHostImpl*>(frame)->ExecuteVersaniumYoutubeCandidate(
+      mobile, std::move(result_callback));
+}
