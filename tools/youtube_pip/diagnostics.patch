+    // Opt-in diagnosis only. Do not log URLs, titles, config, or private tabs.
+    private String mLastTitaniumPipDiagnostic = "";
+
+    private void reportTitaniumYoutubePip(String stage) {
+        if (!org.chromium.base.CommandLine.isInitialized()
+                || !org.chromium.base.CommandLine.getInstance().hasSwitch(
+                        "versanium-youtube-diagnostics")
+                || !LibraryLoader.getInstance().isInitialized()) return;
+        if (mActivity.isDestroyed() || mActivity.isFinishing()) return;
+        Tab tab = mActivityTabProvider.get();
+        WebContents contents = getWebContents();
+        if (tab == null || tab.isDestroyed() || contents == null || contents.isDestroyed() || tab.isOffTheRecord()) return;
+        org.chromium.url.GURL url = contents.getLastCommittedUrl();
+        String host = url.getHost();
+        if (!"https".equals(url.getScheme()) || !("youtube.com".equals(host)
+                || "www.youtube.com".equals(host) || "m.youtube.com".equals(host))) return;
+        String record = stage
+                + " inPip=" + mActivity.isInPictureInPictureMode()
+                + " changing=" + mActivity.isChangingConfigurations();
+        if (!record.equals(mLastTitaniumPipDiagnostic)) {
+            mLastTitaniumPipDiagnostic = record;
+            Log.i("VersaniumPiP", "%s", record);
+        }
+    }
